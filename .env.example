# ==============================================================================
# SentinelAPI — Environment Variables (Production & Local)
# Copy this file to .env.local for development.
# Never commit real API keys or secrets to version control.
# ==============================================================================

# Application URL (Used for Canonical URLs, OAuth redirects, and sitemaps)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Public Keys (Required for Client & SSR Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Server-side privileged operations only; NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Scanner backend URL. The Railway all-in-one deployment uses this same loopback default.
SCANNER_API_URL=http://127.0.0.1:5000

# Public judge demo only: enables the scanner proxy without Supabase auth.
# The backend then permits loopback targets only. Keep AUTHORIZED_TARGET_HOSTS empty.
PUBLIC_DEMO_MODE=false

# Cloudflare Turnstile / Bot Protection (Optional on development, recommended for production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Automated Verification Secret for encrypting stored test credentials at rest
ENCRYPTION_SECRET=sentinel_prod_aes256_change_in_production_key_32chars!

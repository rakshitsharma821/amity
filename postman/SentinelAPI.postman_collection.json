{
  "info": {
    "_postman_id": "7a3e8952-b1c4-482a-9e12-sentinelapi01",
    "name": "SentinelAPI - Zero-Trust Scanner & Sandbox Test Suite",
    "description": "Comprehensive Postman test collection for SentinelAPI backend endpoints and the local vulnerable test sandbox API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "app_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "sandbox_url",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "target_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. SentinelAPI Platform Routes",
      "item": [
        {
          "name": "Domain Verification (Developer Attestation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"baseUrl\": \"https://veil-api-vuiz.onrender.com\",\n  \"verificationToken\": \"sentinel_verify_test_token_123\",\n  \"verificationMethod\": \"developer_attestation\",\n  \"developerAttestation\": true\n}"
            },
            "url": {
              "raw": "{{app_url}}/api/verify-domain",
              "host": ["{{app_url}}"],
              "path": ["api", "verify-domain"]
            },
            "description": "Authorizes a domain for scanning using developer attestation."
          },
          "response": []
        },
        {
          "name": "Domain Verification (HTTP /.well-known File Check)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"baseUrl\": \"http://localhost:4000\",\n  \"verificationToken\": \"sentinel_verify_sandbox_token\",\n  \"verificationMethod\": \"well_known\"\n}"
            },
            "url": {
              "raw": "{{app_url}}/api/verify-domain",
              "host": ["{{app_url}}"],
              "path": ["api", "verify-domain"]
            },
            "description": "Verifies ownership via HTTP /.well-known/sentinelapi-verify.txt check."
          },
          "response": []
        },
        {
          "name": "Launch Security Audit Scan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "pm.test('Scan completed successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData.status).to.eql('completed');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"baseUrl\": \"https://veil-api-vuiz.onrender.com\",\n  \"specUrl\": \"https://veil-api-vuiz.onrender.com/openapi.json\",\n  \"isVerified\": true\n}"
            },
            "url": {
              "raw": "{{app_url}}/api/scans",
              "host": ["{{app_url}}"],
              "path": ["api", "scans"]
            },
            "description": "Runs real zero-trust vulnerability scanner against target."
          },
          "response": []
        },
        {
          "name": "Fetch All Audit Findings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{app_url}}/api/findings",
              "host": ["{{app_url}}"],
              "path": ["api", "findings"]
            },
            "description": "Retrieves saved vulnerability telemetry findings from PostgreSQL."
          },
          "response": []
        },
        {
          "name": "Ask Sentinel SOC AI Bot",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Explain BOLA and generate a FastAPI code fix for orders/{id}\",\n  \"target\": {\n    \"name\": \"VEIL Security API\",\n    \"baseUrl\": \"https://veil-api-vuiz.onrender.com\"\n  },\n  \"findings\": [\n    {\n      \"title\": \"BOLA / IDOR at /orders/{id}\",\n      \"severity\": \"High\",\n      \"endpoint\": \"https://veil-api-vuiz.onrender.com/orders/{id}\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{app_url}}/api/bot/chat",
              "host": ["{{app_url}}"],
              "path": ["api", "bot", "chat"]
            },
            "description": "Interacts with the SOC AI Copilot for vulnerability explanations and code patches."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Local Vulnerable Sandbox API (Port 4000)",
      "item": [
        {
          "name": "Sandbox - Root & Available Routes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sandbox_url}}/",
              "host": ["{{sandbox_url}}"],
              "path": [""]
            },
            "description": "Inspect test sandbox API information."
          },
          "response": []
        },
        {
          "name": "Sandbox - OpenAPI 3.0 Spec",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sandbox_url}}/openapi.json",
              "host": ["{{sandbox_url}}"],
              "path": ["openapi.json"]
            },
            "description": "Fetch OpenAPI schema containing endpoint definitions."
          },
          "response": []
        },
        {
          "name": "Sandbox - Login as Alice",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('auth_token', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"alice123\"\n}"
            },
            "url": {
              "raw": "{{sandbox_url}}/login",
              "host": ["{{sandbox_url}}"],
              "path": ["login"]
            },
            "description": "Authenticates test user Alice and stores Bearer token in collection variable."
          },
          "response": []
        },
        {
          "name": "Sandbox - Get Own Order (Authorized)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{sandbox_url}}/orders/1",
              "host": ["{{sandbox_url}}"],
              "path": ["orders", "1"]
            },
            "description": "Alice accesses her own order (ID 1)."
          },
          "response": []
        },
        {
          "name": "Sandbox - BOLA / IDOR Flaw (Access Victim Bob's Order)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{sandbox_url}}/orders/3",
              "host": ["{{sandbox_url}}"],
              "path": ["orders", "3"]
            },
            "description": "Alice uses her token to access Bob's order (ID 3). Vulnerable API returns Bob's order including unmasked credit card."
          },
          "response": []
        },
        {
          "name": "Sandbox - Sensitive Data Exposure (User Details)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{sandbox_url}}/users/2",
              "host": ["{{sandbox_url}}"],
              "path": ["users", "2"]
            },
            "description": "Alice views Bob's user profile which leaks Bob's plaintext password."
          },
          "response": []
        }
      ]
    }
  ]
}
